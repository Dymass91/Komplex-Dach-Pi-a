---
import type { ComponentProps } from 'astro/types';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import BlueprintCard from '../../components/BlueprintCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';

// Miniatury: rysunki blueprint (6 wspólnych ze stroną główną + 4 w tym samym stylu)
const blueprintFor: Record<string, ComponentProps<typeof BlueprintCard>['service']> = {
  'wykonanie-dachow': 'wykonanie',
  'naprawa-dachu': 'naprawy',
  'przeglad-dachu': 'przeglady',
  'serwis-dachu': 'serwis',
  'wycena-dachu': 'wycena',
  'docieplenie-poddasza': 'ocieplanie',
  'montaz-okien-dachowych': 'okna',
  'odsniezanie-dachow': 'odsniezanie',
  'przeglad-dachu-przed-zima': 'przedzimowy',
  'obrobki-blacharskie-kominow': 'obrobki',
};

const crumbs = [
  { name: 'Strona główna', href: '/' },
  { name: 'Usługi', href: '/uslugi/' },
];
const site = Astro.site!;
const listLd = {
  '@type': 'ItemList',
  name: 'Usługi dekarskie Komplex-Dach Piła',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: new URL(`/uslugi/${s.slug}/`, site).href })),
};
---

<Base
  title="Usługi dekarskie w Pile i okolicach | Komplex-Dach"
  description="Wszystkie usługi dekarskie Komplex-Dach w Pile i okolicach: dachy, naprawy, przeglądy, serwis, wyceny, docieplenia, okna dachowe, odśnieżanie."
  breadcrumbs={crumbs}
  jsonLd={[listLd]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Usługi"
    title="Usługi dekarskie w Pile i okolicach"
    lead="Od nowego dachu po pojedynczą dachówkę. Wybierz usługę, aby dowiedzieć się więcej — albo po prostu zadzwoń i opisz, czego potrzebujesz."
  />

  <section class="bg-paper py-16 md:py-24" aria-label="Lista usług">
    <div class="container-x">
      <ol class="divide-y divide-ink/10 border-y border-ink/10">
        {
          services.map((s, i) => (
            <li data-reveal>
              <a href={`/uslugi/${s.slug}/`} class="group grid grid-cols-[auto_1fr_auto] items-center gap-5 py-6 md:grid-cols-[60px_160px_1fr_auto] md:gap-8 md:py-7">
                <span class="font-mono text-xs text-blue">{String(i + 1).padStart(2, '0')}</span>
                <span class="hidden aspect-[4/3] overflow-hidden rounded-md md:block">
                  <BlueprintCard service={blueprintFor[s.slug]} label="" class="transition-transform duration-700 group-hover:scale-110" />
                </span>
                <span>
                  <h2 class="text-[clamp(1.2rem,2.2vw,1.75rem)] font-bold tracking-tight transition-colors group-hover:text-blue">{s.name}</h2>
                  <p class="mt-1.5 line-clamp-2 max-w-2xl text-sm text-ink/65">{s.lead}</p>
                </span>
                <span class="grid h-11 w-11 place-items-center rounded-full border border-ink/15 transition-colors group-hover:border-blue group-hover:bg-blue group-hover:text-white">
                  <Icon name="arrow" size={18} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <a href="/mycie-dachow/" class="group mt-8 flex items-center justify-between gap-5 rounded-xl border border-ink/10 bg-white p-5 transition-colors hover:border-blue md:p-6" data-reveal>
        <span>
          <span class="eyebrow">Także</span>
          <span class="mt-1 block text-[clamp(1.1rem,2vw,1.4rem)] font-bold tracking-tight group-hover:text-blue">Mycie dachów</span>
          <span class="mt-1 block text-sm text-ink/65">Mycie dachów z podnośnika koszowego — zobacz filmy z naszej pracy.</span>
        </span>
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-ink/15 transition-colors group-hover:border-blue group-hover:bg-blue group-hover:text-white">
          <Icon name="arrow" size={18} />
        </span>
      </a>
    </div>
  </section>

  <CtaBand />
</Base>
