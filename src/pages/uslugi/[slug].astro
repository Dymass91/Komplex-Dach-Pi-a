---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import PhoneLink from '../../components/PhoneLink.astro';
import { services, getService, type Service } from '../../data/services';
import { photos } from '../../data/images';
import { business } from '../../data/site';
import { locationPages } from '../../data/locations';

export const getStaticPaths = (() => services.map((service) => ({ params: { slug: service.slug }, props: { service } }))) satisfies GetStaticPaths;

const { service } = Astro.props as { service: Service };
const photo = service.photo ? photos[service.photo] : undefined;
const related = service.related.map((s) => getService(s)!).filter(Boolean);
const site = Astro.site!;

const crumbs = [
  { name: 'Strona główna', href: '/' },
  { name: 'Usługi', href: '/uslugi/' },
  { name: service.name, href: `/uslugi/${service.slug}/` },
];

const jsonLd = [
  {
    '@type': 'Service',
    name: service.name,
    serviceType: service.name,
    description: service.metaDescription,
    url: new URL(`/uslugi/${service.slug}/`, site).href,
    provider: { '@id': new URL('/#firma', site).href },
    areaServed: [{ '@type': 'City', name: 'Piła' }, ...locationPages.map((l) => ({ '@type': 'City', name: l.name }))],
  },
  {
    '@type': 'FAQPage',
    mainEntity: service.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={service.metaTitle} description={service.metaDescription} breadcrumbs={crumbs} jsonLd={jsonLd} ogImage={photo?.src}>
  <PageHero crumbs={crumbs} eyebrow="Usługi dekarskie · Piła i okolice" title={service.h1} lead={service.lead} photo={photo} drawing={service.drawing} />

  <div class="bg-paper py-16 md:py-24">
    <div class="container-x grid gap-14 lg:grid-cols-[1fr_340px] lg:gap-20">
      <article class="prose-kd max-w-3xl">
        {
          service.sections.map((sec) => (
            <section data-reveal>
              <h2>{sec.h2}</h2>
              {sec.body.map((p) => <p>{p}</p>)}
              {sec.list && (
                <ul>
                  {sec.list.map((li) => <li>{li}</li>)}
                </ul>
              )}
            </section>
          ))
        }

        <section data-reveal>
          <h2>Obszar działania</h2>
          <p>
            Pracujemy w Pile i w promieniu około {business.radiusKm} km — dla domów, firm i wspólnot mieszkaniowych, m.in. w
            {' '}{locationPages.map((l, i) => (
              <>
                <a class="font-medium text-blue underline decoration-blue/30 underline-offset-4 hover:decoration-blue" href={`/obszar-dzialania/${l.slug}/`}>{l.locative}</a>{i < locationPages.length - 2 ? ', ' : i === locationPages.length - 2 ? ' i ' : '.'}
              </>
            ))}
            {' '}Sprawdź <a class="font-medium text-blue underline decoration-blue/30 underline-offset-4" href="/obszar-dzialania/">pełny obszar działania</a>.
          </p>
        </section>

        <section class="mt-16" aria-labelledby="faq-title">
          <h2 id="faq-title" class="!mt-0">Najczęstsze pytania</h2>
          <div class="mt-6"><Faq items={service.faq} /></div>
        </section>
      </article>

      <aside class="lg:pt-14">
        <div class="space-y-6 lg:sticky lg:top-28">
          <div class="rounded-xl bg-night p-7 text-white">
            <p class="eyebrow eyebrow-light">Zadzwoń</p>
            <p class="mt-3 text-lg font-semibold leading-snug">Opisz swój dach przez telefon — doradzimy, od czego zacząć.</p>
            <PhoneLink class="mt-6 w-full" location="service-aside" />
            <p class="mt-4 text-xs text-white/60">Nie prowadzimy kontaktu mailowego ani formularzy.</p>
          </div>
          <nav aria-labelledby="related-title" class="rounded-xl border border-ink/10 bg-white p-7">
            <h2 id="related-title" class="text-sm font-semibold">Powiązane usługi</h2>
            <ul class="mt-4 divide-y divide-ink/10">
              {
                related.map((r) => (
                  <li>
                    <a href={`/uslugi/${r.slug}/`} class="group flex items-center justify-between gap-4 py-3 text-sm font-medium hover:text-blue">
                      {r.name}
                      <Icon name="arrow" size={16} class="text-blue transition-transform group-hover:translate-x-1" />
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href="/uslugi/" class="link-arrow mt-4">Wszystkie usługi <Icon name="arrow" size={14} /></a>
          </nav>
        </div>
      </aside>
    </div>
  </div>

  <CtaBand title={`${service.name} — zadzwoń i umów się`} />
</Base>
