---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Gallery from '../components/Gallery.astro';
import RealizacjeGallery from '../components/RealizacjeGallery.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import PhoneLink from '../components/PhoneLink.astro';
import { pary, realizacjaImg } from '../data/realizacje';

const crumbs = [
  { name: 'Strona główna', href: '/' },
  { name: 'Realizacje', href: '/realizacje/' },
];
---

<Base
  title="Realizacje — zdjęcia dachów, kominów i obróbek | Komplex-Dach Piła"
  description="Zdjęcia z pracy Komplex-Dach: nowe dachy, wymiana pokryć, kominy, obróbki, hale i mycie dachów. Oryginalne zdjęcia z telefonu. Tel. 601 568 841."
  breadcrumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Realizacje"
    title="Zdjęcia z naszej pracy"
    lead="Oryginalne zdjęcia z telefonu: nowe dachy, wymiana pokryć, kominy, obróbki i obiekty firmowe. Kliknij zdjęcie, aby je powiększyć."
  />

  <!-- W trakcie → po -->
  <section class="bg-white py-16 md:py-24" aria-labelledby="pary-title">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <p class="eyebrow">Krok po kroku</p>
          <h2 id="pary-title" class="h-section mt-3">W trakcie i po zakończeniu</h2>
          <p class="mt-3 max-w-2xl text-ink/70">Zestawy zdjęć z tej samej realizacji — od etapu prac do gotowego dachu.</p>
        </div>
      </div>
      <ul class="mt-10 grid gap-6 md:grid-cols-2">
        {
          pary.map((p) => (
            <li class="overflow-hidden rounded-lg border border-ink/10 bg-paper" data-reveal>
              <div class="grid grid-cols-2 gap-px bg-ink/10">
                {[
                  [p.from, 'W trakcie'],
                  [p.to, 'Po'],
                ].map(([id, label]) => (
                  <figure class="relative aspect-[4/3] overflow-hidden bg-graphite">
                    <Image src={realizacjaImg(id)} alt={`${p.title} — ${label.toLowerCase()}`} widths={[360, 560, 720]} sizes="(min-width: 768px) 24vw, 50vw" format="webp" quality={74} class="h-full w-full object-cover" />
                    <figcaption class="absolute left-2 top-2 rounded bg-ink/80 px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.12em] text-white">{label}</figcaption>
                  </figure>
                ))}
              </div>
              <div class="p-5">
                <h3 class="font-bold">{p.title}</h3>
                <p class="mt-1 text-sm text-ink/70">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Galeria z kategoriami -->
  <section class="bg-paper py-16 md:py-24" aria-labelledby="galeria-title">
    <div class="container-x">
      <div data-reveal>
        <p class="eyebrow">Galeria</p>
        <h2 id="galeria-title" class="h-section mt-3">Wybrane realizacje</h2>
        <p class="mt-3 max-w-2xl text-ink/70">
          Zdjęcia pogrupowane według realizacji — od etapu prac do gotowego dachu. Wybierz kategorię, aby zobaczyć konkretny
          rodzaj prac. Na jednym zdjęciu zamazano tablicę rejestracyjną i numer
          domu — poza tym zdjęcia nie są przetwarzane.
        </p>
      </div>
      <div class="mt-8"><RealizacjeGallery /></div>

      <div class="mt-12 flex flex-col items-start justify-between gap-6 rounded-xl bg-night p-6 text-white sm:flex-row sm:items-center md:p-8" data-reveal>
        <div>
          <p class="text-lg font-semibold">Masz podobny dach do zrobienia?</p>
          <p class="mt-1 text-sm text-white/70">Opisz go przez telefon — powiemy, od czego zacząć, i umówimy wycenę.</p>
        </div>
        <PhoneLink location="realizacje-gallery" />
      </div>

      <a href="/mycie-dachow/" class="group mt-6 flex items-center justify-between gap-4 rounded-xl border border-ink/10 bg-white p-5 transition-colors hover:border-blue" data-reveal>
        <span>
          <span class="eyebrow">Mycie dachów</span>
          <span class="mt-1 block font-semibold">Zobacz filmy z mycia dachów z podnośnika</span>
        </span>
        <Icon name="arrow" size={20} class="shrink-0 text-blue transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </section>

  <!-- Dotychczasowe zdjęcia -->
  <section class="bg-white py-16 md:py-24" aria-labelledby="wiecej-title">
    <div class="container-x">
      <h2 id="wiecej-title" class="h-section" data-reveal>Więcej zdjęć z pracy</h2>
      <div class="mt-8"><Gallery layout="grid" /></div>
    </div>
  </section>

  <CtaBand title="Chcesz podobny dach? Zadzwoń." />
</Base>
