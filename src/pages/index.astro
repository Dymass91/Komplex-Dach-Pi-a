---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PhoneLink from '../components/PhoneLink.astro';
import Drawing from '../components/Drawing.astro';
import Gallery from '../components/Gallery.astro';
import AreaMap from '../components/AreaMap.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { business } from '../data/site';
import { photos } from '../data/images';
import { services, getService } from '../data/services';
import { locations, locationPages } from '../data/locations';

const featured = ['wykonanie-dachow', 'naprawa-dachu', 'przeglad-dachu', 'docieplenie-poddasza', 'montaz-okien-dachowych', 'odsniezanie-dachow'].map(
  (s) => getService(s)!,
);
const more = services.filter((s) => !featured.includes(s));

const why = [
  { icon: 'badge', title: 'Doświadczenie', text: `${business.experienceLabel} przy dachach` },
  { icon: 'layers', title: 'Szeroki zakres usług', text: 'od nowych dachów po drobne naprawy' },
  { icon: 'tools', title: 'Własny sprzęt', text: 'profesjonalne narzędzia i warsztat' },
  { icon: 'users', title: 'Obsługa klientów', text: 'indywidualnych, firm i wspólnot' },
  { icon: 'call', title: 'Bezpośredni kontakt', text: 'dzwonisz i rozmawiasz z fachowcem' },
  { icon: 'radius', title: 'Działamy w promieniu', text: `${business.radiusKm} km od Piły` },
] as const;

const seasonal = [
  { icon: 'wrench', title: 'Naprawy i przecieki', text: 'szukamy przyczyny, nie tylko śladu wody', href: '/uslugi/naprawa-dachu/' },
  { icon: 'search', title: 'Przeglądy przed zimą', text: 'pokrycie, obróbki, kominy i rynny', href: '/uslugi/przeglad-dachu-przed-zima/' },
  { icon: 'snow', title: 'Odśnieżanie dachów', text: 'domy, wspólnoty i obiekty firmowe', href: '/uslugi/odsniezanie-dachow/' },
] as const;

const process = [
  { title: 'Telefon', text: `Dzwonisz pod ${business.phoneDisplay} i krótko opisujesz budynek oraz to, czego potrzebujesz.` },
  { title: 'Oględziny', text: 'Jeśli sprawa tego wymaga, umawiamy się na obejrzenie dachu na miejscu.' },
  { title: 'Wycena', text: 'Ustalamy zakres prac i przedstawiamy wycenę dopasowaną do Twojego dachu.' },
  { title: 'Realizacja', text: 'Uzgadniamy termin i wykonujemy prace dekarskie.' },
];

const faq = [
  { q: 'Czy wykonujecie zarówno nowe dachy, jak i naprawy?', a: 'Tak. Wykonujemy dachy kompleksowo — na nowych budynkach i przy wymianie pokrycia — a także naprawy, przeglądy i serwis dachów.' },
  { q: 'Czy dojeżdżacie do miejscowości poza Piłą?', a: `Tak, pracujemy w Pile i w promieniu około ${business.radiusKm} km, m.in. w Wałczu, Złotowie, Chodzieży, Trzciance, Czarnkowie, Wągrowcu i Szczecinku.` },
  { q: 'Jak umówić wycenę?', a: `Najprościej zadzwonić pod numer ${business.phoneDisplay}. Opisz krótko budynek i zakres prac — ustalimy, czy potrzebne są oględziny na miejscu.` },
  { q: 'Czy można się z wami skontaktować mailowo lub przez formularz?', a: `Kontakt prowadzimy telefonicznie — to najszybszy sposób, żeby omówić sprawę dachu. Zadzwoń: ${business.phoneDisplay}.` },
  { q: 'Czy ocieplacie poddasza?', a: 'Tak, wykonujemy docieplenie poddasza — samodzielnie lub razem z pracami dachowymi.' },
  { q: 'Czy zajmujecie się odśnieżaniem dachów?', a: 'Tak, zimą odśnieżamy dachy domów, wspólnot mieszkaniowych oraz obiektów firmowych i magazynowych.' },
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const majorTowns = [{ name: 'Piła', slug: '' }, ...locations.filter((l) => l.major)];
---

<Base
  title="Dekarz Piła — wykonanie dachów, naprawy i przeglądy | Komplex-Dach"
  description="Komplex-Dach Piła: kompleksowe wykonanie dachów, naprawy i usuwanie przecieków, przeglądy, docieplenie poddaszy, okna dachowe, odśnieżanie. Piła i ok. 100 km. Tel. 601 568 841."
  jsonLd={[faqLd]}
>
  <!-- 1. HERO -->
  <section data-hero class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink text-white" aria-labelledby="hero-title">
    <div class="absolute inset-0 -z-10">
      <div data-hero-media class="absolute inset-0 origin-center">
        <Picture
          src={photos.retuszBudynek.src}
          alt={photos.retuszBudynek.alt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          quality={78}
          widths={[720, 1080, 1440, 1926]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          pictureAttributes={{ class: 'block h-full w-full' }}
          class="h-full w-full object-cover object-[68%_center] md:object-[75%_center]"
        />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/75 to-ink/0 max-md:from-ink/70 max-md:via-ink/35 max-md:to-ink/10"></div>
      <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-ink via-ink/60 to-transparent max-md:h-3/4 max-md:via-ink/75"></div>
      <div class="grid-lines absolute inset-0 opacity-60 [mask-image:linear-gradient(to_right,black,transparent_60%)]"></div>
    </div>

    <div class="container-x relative flex flex-1 flex-col justify-end pb-10 pt-32 md:justify-center md:pb-12 md:pt-36" data-hero-content>
      <p class="eyebrow eyebrow-light max-w-[22rem] leading-relaxed" data-hero-fade>Profesjonalne usługi dekarskie w Pile i okolicach</p>
      <h1 id="hero-title" class="h-display mt-5 text-[clamp(3rem,8.4vw,6.6rem)]">
        <span data-hero-line><span>Dachy,</span></span>
        <span data-hero-line><span>które dają</span></span>
        <span data-hero-line><span class="text-blue">spokój</span></span>
      </h1>
      <p class="mt-6 max-w-[30rem] text-[1.05rem] leading-relaxed text-white/80" data-hero-fade data-hero-rise>
        Kompleksowe wykonanie dachów, naprawy, przeglądy, serwis i wszystkie niezbędne prace dekarskie. Z dbałością o każdy
        detal — od pokrycia po obróbkę komina.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3" data-hero-fade data-hero-rise>
        <PhoneLink class="!px-7 !py-4 !text-lg" location="hero" />
        <a href="#realizacje" class="link-arrow !text-white/80 hover:!text-white">Zobacz realizacje <Icon name="arrow" size={16} /></a>
      </div>
      <p class="mt-3 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-white/50" data-hero-fade>Zadzwoń i umów wycenę</p>

      <dl class="mt-12 grid max-w-2xl grid-cols-3 divide-x divide-white/15 border-t border-white/10 pt-6 md:mt-16" data-hero-fade>
        <div class="pr-4">
          <dt class="sr-only">Doświadczenie</dt>
          <dd class="text-[clamp(1.5rem,3vw,2.2rem)] font-bold leading-none">ok. <span data-count={business.experienceYears}>{business.experienceYears}</span></dd>
          <dd class="mt-2 text-xs text-white/60 sm:text-sm">lat doświadczenia</dd>
        </div>
        <div class="px-4 sm:px-6">
          <dt class="sr-only">Zakres usług</dt>
          <dd class="text-[clamp(1.5rem,3vw,2.2rem)] font-bold leading-none"><span data-count={services.length}>{services.length}</span></dd>
          <dd class="mt-2 text-xs text-white/60 sm:text-sm">rodzajów usług dachowych</dd>
        </div>
        <div class="pl-4 sm:pl-6">
          <dt class="sr-only">Obszar działania</dt>
          <dd class="text-[clamp(1.5rem,3vw,2.2rem)] font-bold leading-none"><span data-count={business.radiusKm}>{business.radiusKm}</span> km</dd>
          <dd class="mt-2 text-xs text-white/60 sm:text-sm">obszar działania</dd>
        </div>
      </dl>
    </div>

    <!-- Odręczny dopisek, jak w referencji -->
    <p class="pointer-events-none absolute right-[6%] top-[22%] hidden rotate-[-6deg] text-right font-hand text-[2.4rem] leading-[0.95] text-white/90 lg:block" data-hero-fade aria-hidden="true">
      Rzemiosło<br />dekarskie<br />z Piły
      <svg class="ml-auto mt-2 w-20 text-sky" viewBox="0 0 80 30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 4c20 18 46 22 70 14M62 10l10 8-12 4" /></svg>
    </p>
    <p class="absolute bottom-4 right-5 hidden font-mono text-[0.58rem] uppercase tracking-[0.16em] text-white/35 md:block">
      Fot. 01 — kadr poprawiony cyfrowo, ilustracyjny
    </p>
  </section>

  <!-- 2. USŁUGI -->
  <section id="uslugi" class="bg-white py-20 md:py-28" aria-labelledby="uslugi-title">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <p class="eyebrow">Nasze usługi</p>
          <h2 id="uslugi-title" class="h-section mt-3">Kompleksowe usługi dekarskie</h2>
        </div>
        <a href="/uslugi/" class="link-arrow">Zobacz wszystkie usługi <Icon name="arrow" size={16} /></a>
      </div>

      <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
        {
          featured.map((s) => (
            <li data-reveal>
              <a href={`/uslugi/${s.slug}/`} class="group block">
                <div class="relative aspect-[4/3] overflow-hidden rounded-md bg-graphite">
                  {s.photo ? (
                    <Image
                      src={photos[s.photo].src}
                      alt={photos[s.photo].alt}
                      widths={[320, 520]}
                      sizes="(min-width: 1024px) 16vw, (min-width: 640px) 30vw, 46vw"
                      class="h-full w-full object-cover transition-transform duration-[1.1s] ease-[var(--ease-out-expo)] group-hover:scale-[1.07]"
                    />
                  ) : (
                    <Drawing name={s.drawing} label={`Rysunek techniczny: ${s.name}`} class="transition-transform duration-[1.1s] ease-[var(--ease-out-expo)] group-hover:scale-[1.07]" />
                  )}
                  <span class="absolute inset-x-0 bottom-0 h-0.5 origin-left scale-x-0 bg-blue transition-transform duration-500 group-hover:scale-x-100" />
                </div>
                <h3 class="mt-4 text-[0.98rem] font-bold leading-snug">
                  {s.card[0]}
                  <span class="mt-0.5 flex items-center gap-1.5 font-normal text-ink/65">
                    {s.card[1]}
                    <Icon name="arrow" size={14} class="text-blue transition-transform duration-300 group-hover:translate-x-1" />
                  </span>
                </h3>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-ink/10 pt-6 text-sm text-ink/60" data-reveal>
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-ink/45">Także:</span>
        {more.map((s) => <a href={`/uslugi/${s.slug}/`} class="font-medium text-ink/80 underline decoration-blue/40 underline-offset-4 hover:text-blue">{s.name}</a>)}
      </p>
    </div>
  </section>

  <!-- 3. DLACZEGO KOMPLEX-DACH -->
  <section id="o-nas" class="relative bg-white" aria-labelledby="why-title">
    <div data-clip-in class="relative overflow-hidden bg-night text-white">
      <div class="grid-lines absolute inset-0 opacity-50"></div>
      <div class="container-x relative grid gap-12 py-20 md:py-24 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
        <div data-reveal>
          <p class="eyebrow eyebrow-light">O firmie</p>
          <h2 id="why-title" class="h-section mt-3">Dlaczego<br />Komplex-Dach?</h2>
          <p class="mt-6 max-w-md leading-relaxed text-white/70">
            Od {business.experienceLabel} zajmujemy się dachami w Pile i okolicach. Stawiamy na solidne wykonanie,
            sprawdzone materiały i uczciwe podejście do każdej realizacji — niezależnie od jej wielkości.
          </p>
          <PhoneLink class="mt-8" location="why" />
        </div>
        <ul class="grid grid-cols-1 gap-px self-center overflow-hidden rounded-xl border border-white/10 bg-white/10 sm:grid-cols-2 xl:grid-cols-3">
          {
            why.map((w) => (
              <li class="flex gap-4 bg-night p-6 xl:flex-col xl:gap-4" data-reveal>
                <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-sky/30 text-sky">
                  <Icon name={w.icon} size={20} />
                </span>
                <span>
                  <span class="block text-[0.95rem] font-semibold">{w.title}</span>
                  <span class="mt-1 block text-sm leading-snug text-white/60">{w.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. REALIZACJE -->
  <section id="realizacje" class="bg-paper py-20 md:py-28" aria-labelledby="realizacje-title">
    <div class="container-x">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div>
          <p class="eyebrow">Realizacje</p>
          <h2 id="realizacje-title" class="h-section mt-3">Wybrane realizacje</h2>
          <p class="mt-3 max-w-xl text-sm text-ink/60">Prawdziwe zdjęcia z naszej pracy — bez retuszu. Kliknij, aby powiększyć.</p>
        </div>
        <a href="/realizacje/" class="link-arrow">Zobacz więcej realizacji <Icon name="arrow" size={16} /></a>
      </div>
      <Gallery limit={7} />
    </div>
  </section>

  <!-- 5. OBSZAR DZIAŁANIA -->
  <section id="obszar" class="relative overflow-hidden bg-mist py-20 md:py-24" aria-labelledby="obszar-title">
    <div class="grid-lines-dark absolute inset-0"></div>
    <div class="container-x relative grid items-center gap-12 lg:grid-cols-[0.95fr_1.2fr_0.6fr] lg:gap-10">
      <div data-reveal>
        <p class="eyebrow">Obszar działania</p>
        <h2 id="obszar-title" class="h-section mt-3">Piła i okolice<br />w promieniu {business.radiusKm} km</h2>
        <p class="mt-5 max-w-md leading-relaxed text-ink/70">
          Dojeżdżamy do klientów indywidualnych, firm, wspólnot mieszkaniowych oraz obiektów komercyjnych i przemysłowych
          w promieniu około {business.radiusKm} km od Piły.
        </p>
        <a href="/obszar-dzialania/" class="btn-dark mt-8 !py-3 !text-sm">Zobacz cały obszar działania <Icon name="arrow" size={16} class="arrow" /></a>
      </div>

      <div class="mx-auto w-full max-w-[520px]" data-reveal>
        <AreaMap compact />
        <p class="mt-2 text-center font-mono text-[0.6rem] uppercase tracking-[0.14em] text-ink/40">Schemat · odległości w linii prostej</p>
      </div>

      <div class="rounded-xl bg-night p-6 text-white shadow-[0_30px_60px_-30px_rgba(7,10,16,0.6)]" data-reveal>
        <p class="text-sm font-semibold leading-snug">Przykładowe obsługiwane miejscowości:</p>
        <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1.5 text-[0.82rem] text-white/75 lg:grid-cols-1">
          {
            majorTowns.map((t) => {
              const hasPage = locationPages.some((l) => l.slug === t.slug);
              const href = t.slug === '' ? '/' : hasPage ? `/obszar-dzialania/${t.slug}/` : null;
              return (
                <li class="flex items-center gap-2">
                  <span class="h-1 w-1 rounded-full bg-sky" />
                  {href ? <a class="hover:text-sky" href={href}>{t.name}</a> : t.name}
                </li>
              );
            })
          }
          <li class="mt-1 text-white/50">i wiele innych</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 6. DETALE I OBRÓBKI BLACHARSKIE (panele dzielone) -->
  <section class="bg-ink text-white" aria-labelledby="detale-title">
    <h2 id="detale-title" class="sr-only">Detale i obróbki blacharskie</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4">
      <figure class="relative aspect-[4/3] overflow-hidden md:aspect-auto md:min-h-[380px]">
        <div class="absolute inset-[-8%_0]" data-parallax="10">
          <Image src={photos.kominCzerwony.src} alt={photos.kominCzerwony.alt} widths={[382]} sizes="(min-width:1024px) 25vw, 50vw" class="h-full w-full object-cover" />
        </div>
      </figure>
      <div class="flex flex-col justify-center bg-night p-8 lg:p-10" data-reveal>
        <p class="eyebrow eyebrow-light">Obróbki blacharskie</p>
        <h3 class="mt-3 text-2xl font-bold leading-tight">Kominy obłożone blachą</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/65">
          Obróbka komina to miejsce, gdzie dach najczęściej przecieka — i detal, który widać z ulicy. Na zdjęciu: komin
          w czerwonej blasze przy grafitowym pokryciu.
        </p>
        <a href="/uslugi/obrobki-blacharskie-kominow/" class="btn-ghost mt-6 self-start !px-4 !py-2 !text-xs">Zobacz usługę <Icon name="arrow" size={14} class="arrow" /></a>
      </div>
      <figure class="relative aspect-[4/3] overflow-hidden md:aspect-auto md:min-h-[380px]">
        <div class="absolute inset-[-8%_0]" data-parallax="10">
          <Image src={photos.kominGrafitowy.src} alt={photos.kominGrafitowy.alt} widths={[382]} sizes="(min-width:1024px) 25vw, 50vw" class="h-full w-full object-cover" />
        </div>
      </figure>
      <div class="flex flex-col justify-center bg-night p-8 lg:p-10" data-reveal>
        <p class="eyebrow eyebrow-light">Precyzja detalu</p>
        <h3 class="mt-3 text-2xl font-bold leading-tight">Rąbek, zagięcie, spadek</h3>
        <p class="mt-3 text-sm leading-relaxed text-white/65">
          Grafitowa blacha na rąbek i obróbka u podstawy komina. Szczelność dachu zależy od takich połączeń — dlatego
          poświęcamy im najwięcej uwagi.
        </p>
        <a href="/uslugi/naprawa-dachu/" class="btn-ghost mt-6 self-start !px-4 !py-2 !text-xs">Naprawy przecieków <Icon name="arrow" size={14} class="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 7. RZEMIOSŁO / WARSZTAT -->
  <section id="rzemioslo" class="relative overflow-hidden bg-paper py-20 md:py-32" aria-labelledby="rzemioslo-title">
    <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5 lg:pt-10">
        <div class="lg:sticky lg:top-28" data-reveal>
          <p class="eyebrow">Warsztat i narzędzia</p>
          <h2 id="rzemioslo-title" class="mt-4 text-[clamp(2.2rem,4.6vw,4rem)] font-extrabold leading-[0.98] tracking-[-0.03em]">
            Precyzja zaczyna się <span class="text-blue">w warsztacie.</span>
          </h2>
          <p class="mt-6 max-w-md leading-relaxed text-ink/70">
            Dobra robota dekarska to doświadczenie i odpowiedni sprzęt. Na zdjęciach nasz warsztat i narzędzia, z którymi
            pracujemy: akumulatorowe gwoździarki, narzędzia blacharskie i elementy z blachy przygotowane do montażu.
          </p>
          <ul class="mt-8 space-y-3 text-sm text-ink/75">
            <li class="flex items-center gap-3"><Icon name="check" size={18} class="text-blue" /> profesjonalne narzędzia blacharskie</li>
            <li class="flex items-center gap-3"><Icon name="check" size={18} class="text-blue" /> sprzęt akumulatorowy do pracy na dachu</li>
            <li class="flex items-center gap-3"><Icon name="check" size={18} class="text-blue" /> obróbki dopasowywane do konkretnego dachu</li>
          </ul>
        </div>
      </div>

      <div class="grid grid-cols-6 gap-3 sm:gap-4 lg:col-span-7">
        <figure class="col-span-6 overflow-hidden rounded-md" data-reveal-img>
          <Image src={photos.gwozdziarkiDwie.src} alt={photos.gwozdziarkiDwie.alt} widths={[640, 960]} sizes="(min-width:1024px) 55vw, 100vw" class="aspect-[4/3] h-full w-full object-cover" />
        </figure>
        <figure class="col-span-3 overflow-hidden rounded-md" data-reveal-img>
          <Image src={photos.narzedziaWalizka.src} alt={photos.narzedziaWalizka.alt} widths={[480, 716]} sizes="(min-width:1024px) 27vw, 50vw" class="aspect-[3/4] h-full w-full object-cover" />
        </figure>
        <figure class="col-span-3 mt-12 overflow-hidden rounded-md" data-reveal-img>
          <Image src={photos.warsztatElement.src} alt={photos.warsztatElement.alt} widths={[382]} sizes="(min-width:1024px) 27vw, 50vw" class="aspect-[3/4] h-full w-full object-cover" />
        </figure>
        <figure class="col-span-4 overflow-hidden rounded-md" data-reveal-img>
          <Image src={photos.warsztatStol.src} alt={photos.warsztatStol.alt} widths={[640, 960]} sizes="(min-width:1024px) 36vw, 66vw" class="aspect-[4/3] h-full w-full object-cover" />
        </figure>
        <figure class="col-span-2 overflow-hidden rounded-md" data-reveal-img>
          <Image src={photos.gwozdziarkaWalizka.src} alt={photos.gwozdziarkaWalizka.alt} widths={[382]} sizes="(min-width:1024px) 18vw, 33vw" class="h-full w-full object-cover" />
        </figure>
      </div>
    </div>
  </section>

  <!-- 8. NAPRAWY, PRZEGLĄDY, SEZON ZIMOWY -->
  <section id="naprawy" class="relative isolate overflow-hidden bg-night text-white" aria-labelledby="naprawy-title">
    <div class="absolute inset-y-0 right-0 -z-10 w-full lg:w-[58%]">
      <Image src={photos.dachLukarnaSzczyt.src} alt="" widths={[680]} sizes="60vw" class="h-full w-full object-cover object-[40%_30%] opacity-50 lg:opacity-70" />
      <div class="absolute inset-0 bg-gradient-to-r from-night via-night/80 to-night/20"></div>
    </div>
    <div class="container-x grid gap-12 py-20 md:py-24 lg:grid-cols-2 lg:gap-16">
      <div data-reveal>
        <p class="eyebrow eyebrow-light">Naprawy i sezon zimowy</p>
        <h2 id="naprawy-title" class="h-section mt-3 text-balance">Naprawy, przeglądy przed zimą i odśnieżanie dachów</h2>
        <p class="mt-5 max-w-lg leading-relaxed text-white/70">
          Cieknie dach? Zbliża się zima? Zadzwoń i opisz, co się dzieje. Lepiej sprawdzić dach jesienią, niż szukać
          przecieku w lutym. Powiemy uczciwie, kiedy możemy przyjechać.
        </p>
        <PhoneLink class="mt-8" location="repairs" />
      </div>
      <ul class="flex flex-col justify-center gap-4">
        {
          seasonal.map((s) => (
            <li data-reveal>
              <a href={s.href} class="group flex items-center gap-5 rounded-xl border border-white/10 bg-ink/50 p-5 backdrop-blur-sm transition-colors hover:border-sky/50">
                <span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg border border-sky/30 text-sky">
                  <Icon name={s.icon} size={24} />
                </span>
                <span class="flex-1">
                  <span class="block font-semibold">{s.title}</span>
                  <span class="block text-sm text-white/60">{s.text}</span>
                </span>
                <Icon name="arrow" size={18} class="text-white/40 transition-all duration-300 group-hover:translate-x-1 group-hover:text-sky" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 9. TYPY OBIEKTÓW -->
  <section class="bg-paper pt-20 md:pt-28" aria-labelledby="obiekty-title">
    <div class="container-x">
      <div data-reveal>
        <p class="eyebrow">Obsługujemy</p>
        <h2 id="obiekty-title" class="h-section mt-3">Różne typy obiektów</h2>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        <li class="overflow-hidden rounded-lg bg-white shadow-[0_1px_0_rgba(7,10,16,0.06)]" data-reveal>
          <div class="aspect-[16/10] overflow-hidden"><Image src={photos.domWBudowie.src} alt={photos.domWBudowie.alt} widths={[480, 680]} sizes="(min-width:1024px) 24vw, (min-width:640px) 48vw, 100vw" class="h-full w-full object-cover" /></div>
          <div class="p-4 sm:p-5"><h3 class="text-sm font-bold sm:text-base">Domy jednorodzinne</h3><p class="mt-1 text-xs text-ink/60 sm:text-sm">Nowe dachy, wymiana pokrycia, naprawy</p></div>
        </li>
        <li class="overflow-hidden rounded-lg bg-white shadow-[0_1px_0_rgba(7,10,16,0.06)]" data-reveal>
          <div class="grid aspect-[16/10] place-items-center bg-graphite text-sky grid-lines"><Icon name="building" size={64} stroke={1} /></div>
          <div class="p-4 sm:p-5"><h3 class="text-sm font-bold sm:text-base">Firmy i budynki usługowe</h3><p class="mt-1 text-xs text-ink/60 sm:text-sm">Wykonanie, serwis, przeglądy</p></div>
        </li>
        <li class="overflow-hidden rounded-lg bg-white shadow-[0_1px_0_rgba(7,10,16,0.06)]" data-reveal>
          <div class="aspect-[16/10] overflow-hidden"><Image src={photos.budowaWielorodzinny.src} alt={photos.budowaWielorodzinny.alt} widths={[480, 680]} sizes="(min-width:1024px) 24vw, (min-width:640px) 48vw, 100vw" class="h-full w-full object-cover" /></div>
          <div class="p-4 sm:p-5"><h3 class="text-sm font-bold sm:text-base">Wspólnoty mieszkaniowe</h3><p class="mt-1 text-xs text-ink/60 sm:text-sm">Dachy budynków wielorodzinnych</p></div>
        </li>
        <li class="overflow-hidden rounded-lg bg-white shadow-[0_1px_0_rgba(7,10,16,0.06)]" data-reveal>
          <div class="grid aspect-[16/10] place-items-center bg-graphite text-sky grid-lines"><Icon name="factory" size={64} stroke={1} /></div>
          <div class="p-4 sm:p-5"><h3 class="text-sm font-bold sm:text-base">Obiekty komercyjne i przemysłowe</h3><p class="mt-1 text-xs text-ink/60 sm:text-sm">Dachy hal, magazynów, odśnieżanie</p></div>
        </li>
      </ul>
    </div>
  </section>

  <!-- 10. JAK PRACUJEMY -->
  <section id="wspolpraca" class="bg-paper py-20 md:py-28" aria-labelledby="proces-title">
    <div class="container-x">
      <div class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-end" data-reveal>
        <div>
          <p class="eyebrow">Współpraca</p>
          <h2 id="proces-title" class="h-section mt-3">Jak zaczynamy?<br />Od jednego telefonu.</h2>
        </div>
        <p class="max-w-xl text-ink/65 lg:justify-self-end">
          Bez formularzy i maili. Zadzwoń, opowiedz o dachu — resztę ustalimy w rozmowie.
        </p>
      </div>
      <div class="relative mt-14">
        <div class="absolute left-0 right-0 top-[22px] hidden h-px bg-ink/10 md:block">
          <div data-progress class="h-full w-full bg-blue"></div>
        </div>
        <ol class="grid gap-10 md:grid-cols-4 md:gap-8">
          {
            process.map((p, i) => (
              <li class="relative" data-reveal>
                <span class="relative z-10 grid h-11 w-11 place-items-center rounded-full border border-blue/40 bg-paper font-mono text-sm font-medium text-blue">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-5 text-lg font-bold">{p.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-ink/65">{p.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 11. FAQ -->
  <section id="faq" class="border-t border-ink/5 bg-white py-20 md:py-28" aria-labelledby="faq-title">
    <div class="container-x grid gap-10 lg:grid-cols-[0.75fr_1.4fr_0.8fr] lg:gap-12">
      <div data-reveal>
        <p class="eyebrow">Najczęściej zadawane pytania</p>
        <h2 id="faq-title" class="h-section mt-3">FAQ</h2>
        <p class="mt-4 text-sm text-ink/60">Nie ma tu Twojego pytania? Zadzwoń — odpowiemy od razu.</p>
        <PhoneLink variant="dark" class="mt-6 !py-3 !text-sm" location="faq" />
      </div>
      <Faq items={faq} />
      <figure class="hidden overflow-hidden rounded-lg lg:block" data-reveal-img>
        <Image src={photos.kominGrafitowy.src} alt={photos.kominGrafitowy.alt} widths={[382]} sizes="20vw" class="h-full w-full object-cover" />
      </figure>
    </div>
  </section>

  <!-- 12. KONTAKT -->
  <CtaBand />
</Base>
