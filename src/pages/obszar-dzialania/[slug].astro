---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AreaMap from '../../components/AreaMap.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import PhoneLink from '../../components/PhoneLink.astro';
import { business } from '../../data/site';
import { services } from '../../data/services';
import { locationPages, distanceKm, type Location } from '../../data/locations';

export const getStaticPaths = (() => locationPages.map((location) => ({ params: { slug: location.slug }, props: { location } }))) satisfies GetStaticPaths;

const { location: l } = Astro.props as { location: Location };
const page = l.page!;
const km = distanceKm(l);
const site = Astro.site!;

const crumbs = [
  { name: 'Strona główna', href: '/' },
  { name: 'Obszar działania', href: '/obszar-dzialania/' },
  { name: `Dekarz ${l.name}`, href: `/obszar-dzialania/${l.slug}/` },
];

const faq = [
  ...page.faq,
  { q: `Jak umówić dekarza w ${l.locative}?`, a: `Zadzwoń pod numer ${business.phoneDisplay}. Podaj adres i opisz zakres prac — ustalimy termin i to, czy potrzebne są oględziny.` },
];
const others = locationPages.filter((o) => o.slug !== l.slug);

const jsonLd = [
  {
    '@type': 'WebPage',
    name: `Dekarz ${l.name}`,
    url: new URL(`/obszar-dzialania/${l.slug}/`, site).href,
    about: { '@id': new URL('/#firma', site).href },
    spatialCoverage: { '@type': 'City', name: l.name, geo: { '@type': 'GeoCoordinates', latitude: l.lat, longitude: l.lon } },
  },
  // Dane FAQPage tylko dla stron dopuszczonych do indeksowania
  ...(l.indexable
    ? [{ '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }]
    : []),
];
---

<Base
  title={`Dekarz ${l.name} — usługi dekarskie i naprawy dachów`}
  description={page.metaDescription}
  breadcrumbs={crumbs}
  jsonLd={jsonLd}
  noindex={!l.indexable}
>
  <PageHero crumbs={crumbs} eyebrow={`Obszar działania · ok. ${km} km od Piły`} title={`Dekarz ${l.name} — usługi dekarskie i naprawy dachów`} lead={page.intro[0]}>
    <dl class="mt-10 grid max-w-md grid-cols-2 gap-4 border-t border-white/10 pt-6 text-sm" data-hero-fade>
      <div><dt class="text-white/60">Odległość</dt><dd class="mt-1 font-semibold">ok. {km} km</dd></div>
      <div><dt class="text-white/60">Powiat</dt><dd class="mt-1 font-semibold">{l.county}</dd></div>
    </dl>
  </PageHero>

  <section class="bg-paper py-16 md:py-24">
    <div class="container-x grid gap-14 lg:grid-cols-[1fr_420px] lg:gap-20">
      <div class="prose-kd max-w-3xl">
        <h2 class="!mt-0" data-reveal>Usługi dekarskie w {l.locative}</h2>
        {page.intro.slice(1).map((p) => <p data-reveal>{p}</p>)}
        <p data-reveal>
          Z Piły do {page.genitive} jest ok. {km} km w linii prostej. Dojeżdżamy również do okolicznych miejscowości,
          m.in.: {page.nearby.join(', ')}.
        </p>

        <h2 data-reveal>Jak zamówić dekarza z {page.genitive}</h2>
        <ol class="!mt-6 grid !space-y-0 gap-3 sm:grid-cols-3" data-reveal>
          <li class="!pl-0 before:!hidden rounded-lg border border-ink/10 bg-white p-4">
            <span class="font-mono text-xs text-blue">01</span>
            <span class="mt-2 block font-semibold text-ink">Telefon</span>
            <span class="mt-1 block text-sm">
              Zadzwoń pod <a href={business.phoneHref} data-call="city-steps" class="font-semibold text-blue">{business.phoneDisplay}</a>. Kontakt prowadzimy wyłącznie telefonicznie.
            </span>
          </li>
          <li class="!pl-0 before:!hidden rounded-lg border border-ink/10 bg-white p-4">
            <span class="font-mono text-xs text-blue">02</span>
            <span class="mt-2 block font-semibold text-ink">Opis i adres</span>
            <span class="mt-1 block text-sm">Powiedz, co się dzieje z dachem i gdzie stoi budynek w {l.locative} lub okolicy.</span>
          </li>
          <li class="!pl-0 before:!hidden rounded-lg border border-ink/10 bg-white p-4">
            <span class="font-mono text-xs text-blue">03</span>
            <span class="mt-2 block font-semibold text-ink">Oględziny i wycena</span>
            <span class="mt-1 block text-sm">Ustalamy, czy potrzebne są oględziny na miejscu, i przygotowujemy wycenę.</span>
          </li>
        </ol>
        <p data-reveal>
          Przecieka dach? Opisz przez telefon, gdzie i przy jakiej pogodzie pojawia się woda — więcej w opisie usługi
          {' '}<a class="font-medium text-blue underline decoration-blue/30 underline-offset-4" href="/uslugi/naprawa-dachu/">naprawa dachu i usuwanie przecieków</a>.
        </p>

        <h2 data-reveal>Co możemy zrobić w {l.locative}</h2>
        <ul class="!mt-6 grid !space-y-0 gap-2 sm:grid-cols-2" data-reveal>
          {
            services.map((s) => (
              <li class="!pl-0 before:!hidden">
                <a href={`/uslugi/${s.slug}/`} class="group flex items-center justify-between gap-3 rounded-lg border border-ink/10 bg-white px-4 py-3 text-[0.92rem] font-medium text-ink no-underline hover:border-blue">
                  {s.name}
                  <Icon name="arrow" size={16} class="shrink-0 text-blue transition-transform group-hover:translate-x-1" />
                </a>
              </li>
            ))
          }
        </ul>

        <h2 data-reveal>Formalności przy pracach na dachu — {l.name}</h2>
        <p data-reveal>
          To, czy wymiana pokrycia, docieplenie albo przebudowa dachu wymaga zgłoszenia lub pozwolenia, zależy od
          zakresu prac i konkretnego budynku. W sprawach budowlanych z terenu {page.genitive} właściwy jest zwykle
          starosta — przed większą zmianą, np. kształtu lub konstrukcji dachu, warto zapytać w {page.office}.
        </p>
        <p data-reveal>
          Jeśli budynek jest wpisany do rejestru zabytków, prace przy dachu mogą wymagać pozwolenia wojewódzkiego
          konserwatora zabytków (woj. {l.voivodeship}). Przegląd dachu czy odśnieżanie zwykle nie wiążą się
          z formalnościami.
        </p>
        <p class="!text-sm !text-ink/65" data-reveal>
          To informacje ogólne, a nie porada prawna — o wymaganiach dla konkretnego budynku rozstrzyga właściwy urząd.
          Zakres samych prac dekarskich omówimy przez telefon: 601 568 841.
        </p>

        <h2 data-reveal>Najczęstsze pytania — {l.name}</h2>
        <div class="mt-6"><Faq items={faq} /></div>
      </div>

      <aside>
        <div class="space-y-6 lg:sticky lg:top-28">
          <div class="rounded-xl bg-night p-6 text-white">
            <p class="eyebrow eyebrow-light">Dekarz {l.name} — telefon</p>
            <p class="mt-3 text-lg font-semibold leading-snug">Opisz swój dach przez telefon — powiemy, od czego zacząć.</p>
            <PhoneLink class="mt-5 w-full" location="city-aside" />
            <p class="mt-3 text-xs text-white/60">Komplex-Dach z Piły, od {business.foundingYear} r.</p>
          </div>
          <div class="rounded-xl border border-ink/10 bg-white p-5" data-reveal>
            <AreaMap compact highlight={l.slug} />
            <p class="mt-2 text-center font-mono text-[0.58rem] uppercase tracking-[0.14em] text-ink/65">{l.name} na tle obszaru działania</p>
          </div>
          <nav aria-labelledby="inne-title" class="rounded-xl bg-night p-6 text-white">
            <h2 id="inne-title" class="text-sm font-semibold">Inne miejscowości</h2>
            <ul class="mt-4 grid grid-cols-2 gap-2 text-sm">
              {others.map((o) => <li><a href={`/obszar-dzialania/${o.slug}/`} class="text-white/75 hover:text-sky">Dekarz {o.name}</a></li>)}
              <li><a href="/" class="text-white/75 hover:text-sky">Dekarz Piła</a></li>
            </ul>
            <a href="/obszar-dzialania/" class="link-arrow mt-5 !text-sky">Cały obszar działania <Icon name="arrow" size={14} /></a>
          </nav>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand title={`Dach w ${l.locative} lub okolicy? Zadzwoń.`} />
</Base>
