---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AreaMap from '../../components/AreaMap.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { business } from '../../data/site';
import { photos } from '../../data/images';
import { locations, locationPages, distanceKm, direction } from '../../data/locations';

const crumbs = [
  { name: 'Strona główna', href: '/' },
  { name: 'Obszar działania', href: '/obszar-dzialania/' },
];

const byVoivodeship = Object.entries(
  Object.groupBy([...locations].sort((a, b) => a.name.localeCompare(b.name, 'pl')), (l) => l.voivodeship),
);
---

<Base
  title="Obszar działania: Piła i okolice do 100 km | Komplex-Dach"
  description="Pracujemy w Pile i w promieniu ok. 100 km: Wałcz, Złotów, Chodzież, Trzcianka, Czarnków, Wągrowiec, Szczecinek i okolice. Tel. 601 568 841."
  breadcrumbs={crumbs}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Obszar działania"
    title={`Piła i okolice w promieniu ${business.radiusKm} km`}
    lead="Nasza baza jest w Pile. Dojeżdżamy do domów, firm, wspólnot mieszkaniowych oraz obiektów komercyjnych i przemysłowych w północnej Wielkopolsce, na Pomorzu Zachodnim i w sąsiednich regionach."
    photo={photos.autoOsiedle}
  />

  <section class="relative overflow-hidden bg-mist py-16 md:py-24" aria-labelledby="mapa-title">
    <div class="grid-lines-dark absolute inset-0"></div>
    <div class="container-x relative grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="mx-auto w-full max-w-[640px]" data-reveal>
        <AreaMap />
        <p class="mt-3 text-center font-mono text-[0.6rem] uppercase tracking-[0.14em] text-ink/65">Schemat · odległości w linii prostej od centrum Piły</p>
      </div>
      <div data-reveal>
        <h2 id="mapa-title" class="h-section">Gdzie pracujemy</h2>
        <p class="mt-5 leading-relaxed text-ink/70">
          Pracujemy w promieniu około {business.radiusKm} km od Piły. Termin i zakres prac ustalamy telefonicznie.
          Jeśli Twojej miejscowości nie ma na liście — zadzwoń, sprawdzimy dojazd.
        </p>
        <h3 class="mt-10 text-sm font-semibold">Strony lokalne</h3>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          <li>
            <a href="/" class="group flex items-center justify-between rounded-lg border border-ink/10 bg-white px-4 py-3 text-sm font-semibold hover:border-blue">
              Dekarz Piła <Icon name="arrow" size={16} class="text-blue transition-transform group-hover:translate-x-1" />
            </a>
          </li>
          {
            locationPages.map((l) => (
              <li>
                <a href={`/obszar-dzialania/${l.slug}/`} class="group flex items-center justify-between rounded-lg border border-ink/10 bg-white px-4 py-3 text-sm font-semibold hover:border-blue">
                  <span>Dekarz {l.name} <span class="ml-1 font-normal text-ink/65">ok. {distanceKm(l)} km</span></span>
                  <Icon name="arrow" size={16} class="text-blue transition-transform group-hover:translate-x-1" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 md:py-24" aria-labelledby="lista-title">
    <div class="container-x">
      <h2 id="lista-title" class="h-section" data-reveal>Przykładowe miejscowości w obszarze działania</h2>
      <div class="mt-10 grid gap-10 md:grid-cols-2 lg:grid-cols-4">
        {
          byVoivodeship.map(([voiv, list]) => (
            <div data-reveal>
              <h3 class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-blue">woj. {voiv}</h3>
              <ul class="mt-4 space-y-2 text-sm">
                {list!.map((l) => (
                  <li class="flex items-baseline justify-between gap-3 border-b border-ink/5 pb-2">
                    {l.page ? (
                      <a class="font-semibold hover:text-blue" href={`/obszar-dzialania/${l.slug}/`}>{l.name}</a>
                    ) : (
                      <span>{l.name}</span>
                    )}
                    <span class="shrink-0 text-xs text-ink/65">ok. {distanceKm(l)} km · {direction(l)}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="mt-10 max-w-3xl text-sm text-ink/65">
        Odległości są orientacyjne, liczone w linii prostej od centrum Piły — trasa drogowa jest zwykle dłuższa. Lista nie
        jest zamknięta: obsługujemy również wsie i mniejsze miejscowości w tym obszarze.
      </p>
    </div>
  </section>

  <section class="bg-paper py-16 md:py-20" aria-label="W drodze do klienta">
    <div class="container-x grid items-center gap-8 md:grid-cols-2">
      <figure class="overflow-hidden rounded-lg" data-reveal-img>
        <Image src={photos.autoBaza.src} alt={photos.autoBaza.alt} widths={[382]} sizes="(min-width:768px) 40vw, 100vw" class="aspect-[4/3] w-full object-cover" />
      </figure>
      <div data-reveal>
        <p class="eyebrow">Dojazd</p>
        <h2 class="h-section mt-3">Poznasz nas po samochodzie</h2>
        <p class="mt-5 max-w-md leading-relaxed text-ink/70">
          Nasz oznakowany samochód firmowy ma na burcie numer {business.phoneDisplay} — ten sam, który jest jedynym
          kanałem kontaktu z nami.
        </p>
      </div>
    </div>
  </section>

  <CtaBand title="Twoja miejscowość jest w pobliżu? Zadzwoń." />
</Base>
