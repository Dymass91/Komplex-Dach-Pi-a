---
// Galeria realizacji pogrupowana według realizacji (grupy zatwierdzone przez właściciela).
// Filtry kategorii działają na poziomie zdjęć; blok realizacji znika, gdy nie ma w nim pasujących zdjęć.
// Telefon: na start całe realizacje do ok. 12 zdjęć, reszta po „Pokaż więcej realizacji”.
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { categories, grupy, realizacje, realizacjaImg, stageLabel, type Stage } from '../data/realizacje';

const order: Record<Stage, number> = { przed: 0, 'w-trakcie': 1, po: 2 };
const all = realizacje.map((r) => ({ ...r, img: realizacjaImg(r.id) }));
const blocks = grupy
  .map((g) => ({ ...g, photos: all.filter((p) => p.group === g.id).sort((a, b) => order[a.stage] - order[b.stage]) }))
  .filter((g) => g.photos.length);
// Kolejność zdjęć w podglądzie = kolejność wyświetlania
const flat = blocks.flatMap((b) => b.photos.map((p) => ({ ...p, title: b.title })));
const full = await Promise.all(flat.map((p) => getImage({ src: p.img, width: 1600, format: 'webp', quality: 80 })));
const indexOf = (id: string) => flat.findIndex((p) => p.id === id);
const counts = Object.fromEntries(categories.map((c) => [c.id, all.filter((i) => i.cat === c.id).length]));
let no = 0;
---

<div data-rgallery>
  <div class="-mx-5 overflow-x-auto px-5 pb-2 sm:mx-0 sm:px-0" role="group" aria-label="Filtruj realizacje">
    <div class="flex w-max gap-2 sm:w-auto sm:flex-wrap">
      <button type="button" data-filter="all" aria-pressed="true" class="filter">Wszystkie <span>{all.length}</span></button>
      {
        categories.map((c) => (
          <button type="button" data-filter={c.id} aria-pressed="false" class="filter">
            {c.label} <span>{counts[c.id]}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="mt-8 grid gap-5 lg:grid-cols-2" data-rblocks>
    {
      blocks.map((b) => {
        const wide = b.photos.length >= 3 && b.id !== 'INNE';
        const numbered = b.id !== 'INNE';
        if (numbered) no++;
        const stages = [...new Set(b.photos.map((p) => p.stage))];
        return (
          <article
            class:list={['rounded-xl border border-ink/10 p-4 sm:p-5', wide && 'lg:col-span-2', numbered ? 'bg-white' : 'bg-paper']}
            data-rblock
            data-count={b.photos.length}
            aria-labelledby={`r-${b.id}`}
          >
            <header class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
              <div class="min-w-0">
                {numbered && <p class="font-mono text-[0.64rem] uppercase tracking-[0.16em] text-blue">Realizacja {String(no).padStart(2, '0')}</p>}
                <h3 id={`r-${b.id}`} class="mt-1 text-[1.08rem] font-bold leading-snug sm:text-[1.2rem]">{b.title}</h3>
                <p class="mt-1 text-sm text-ink/65">{b.text}</p>
              </div>
              <div class="flex flex-wrap items-center gap-1.5">
                {numbered &&
                  stages.map((s) => (
                    <span class="rounded-full bg-ink/5 px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.1em] text-ink/70">{stageLabel[s]}</span>
                  ))}
                <span class="rounded-full bg-blue/10 px-2 py-0.5 font-mono text-[0.6rem] uppercase tracking-[0.1em] text-blue">
                  {b.photos.length} {b.photos.length === 1 ? 'zdjęcie' : b.photos.length < 5 ? 'zdjęcia' : 'zdjęć'}
                </span>
              </div>
            </header>
            <ul class:list={['mt-4 grid grid-cols-2 gap-2 sm:gap-2.5', wide && 'sm:grid-cols-3 lg:grid-cols-4', b.photos.length === 5 && 'lg:!grid-cols-5', !numbered && 'sm:grid-cols-4 lg:!grid-cols-2']}>
              {b.photos.map((p) => (
                <li data-cat={p.cat}>
                  <button
                    type="button"
                    class="group relative block aspect-[4/3] w-full overflow-hidden rounded-md bg-graphite text-left"
                    data-index={indexOf(p.id)}
                    aria-label={`Powiększ: ${p.caption}`}
                  >
                    <Image
                      src={p.img}
                      alt={p.alt}
                      widths={[360, 560, 800]}
                      sizes={wide ? '(min-width: 1024px) 22vw, (min-width: 640px) 31vw, 46vw' : '(min-width: 1024px) 22vw, 46vw'}
                      format="webp"
                      quality={74}
                      class="h-full w-full object-cover transition-transform duration-[1.1s] ease-[var(--ease-out-expo)] group-hover:scale-[1.05]"
                    />
                    {numbered && (
                      <span class="absolute left-2 top-2 rounded bg-ink/75 px-1.5 py-0.5 font-mono text-[0.58rem] uppercase tracking-[0.12em] text-white backdrop-blur-sm">
                        {stageLabel[p.stage]}
                      </span>
                    )}
                    <span class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/85 via-ink/40 to-transparent px-2.5 pb-2 pt-8 text-[0.74rem] font-semibold leading-snug text-white sm:text-[0.8rem]">
                      {p.caption}
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </article>
        );
      })
    }
  </div>

  <div class="mt-6 text-center md:hidden" data-rmore-wrap hidden>
    <button type="button" class="filter !px-6 !py-3" data-rmore>Pokaż więcej realizacji <span data-rmore-count></span></button>
  </div>

  <dialog class="m-0 h-full max-h-none w-full max-w-none bg-ink/95 p-0 text-white backdrop:bg-ink/80 open:flex open:flex-col" aria-label="Podgląd zdjęcia" data-rlightbox>
    <div class="flex items-center justify-between px-5 py-4">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-white/60"><span data-rcount></span></p>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-full hover:bg-white/10" data-rclose aria-label="Zamknij podgląd">
        <Icon name="close" size={24} />
      </button>
    </div>
    <figure class="flex min-h-0 flex-1 flex-col items-center justify-center gap-3 px-4 pb-6">
      <img data-rimg alt="" class="max-h-[72vh] w-auto max-w-full rounded object-contain" />
      <figcaption class="text-center text-sm text-white/80" data-rcap></figcaption>
    </figure>
    <div class="absolute inset-y-0 left-0 flex items-center px-2 sm:px-5">
      <button type="button" class="grid h-12 w-12 place-items-center rounded-full bg-white/10 hover:bg-blue" data-rprev aria-label="Poprzednie zdjęcie"><Icon name="arrow-left" size={22} /></button>
    </div>
    <div class="absolute inset-y-0 right-0 flex items-center px-2 sm:px-5">
      <button type="button" class="grid h-12 w-12 place-items-center rounded-full bg-white/10 hover:bg-blue" data-rnext aria-label="Następne zdjęcie"><Icon name="arrow" size={22} /></button>
    </div>
  </dialog>

  <script
    type="application/json"
    data-rdata
    set:html={JSON.stringify(flat.map((p, i) => ({ src: full[i].src, alt: p.alt, caption: p.caption, title: p.group === 'INNE' ? '' : p.title })))}
  />
</div>

<style>
  @reference "../styles/global.css";
  .filter {
    @apply inline-flex shrink-0 items-center gap-2 rounded-full border border-ink/15 bg-white px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-blue;
  }
  .filter span {
    @apply rounded-full bg-ink/5 px-1.5 font-mono text-[0.7rem] text-ink/65;
  }
  .filter[aria-pressed='true'] {
    @apply border-blue bg-blue text-white;
  }
  .filter[aria-pressed='true'] span {
    @apply bg-white/20 text-white;
  }
  @media (max-width: 767px) {
    [data-rblock].is-more {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-rgallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-rlightbox]')!;
    const img = root.querySelector<HTMLImageElement>('[data-rimg]')!;
    const cap = root.querySelector<HTMLElement>('[data-rcap]')!;
    const count = root.querySelector<HTMLElement>('[data-rcount]')!;
    const data: { src: string; alt: string; caption: string; title: string }[] = JSON.parse(root.querySelector('[data-rdata]')!.textContent || '[]');
    const blocks = [...root.querySelectorAll<HTMLElement>('[data-rblock]')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button[data-index]')];
    let visible = buttons.map((b) => Number(b.dataset.index));
    let pos = 0;
    let opener: HTMLElement | null = null;

    // Telefon: całe realizacje, dopóki łącznie nie przekroczą ok. 12 zdjęć
    const LIMIT = 12;
    let expanded = false;
    const moreWrap = root.querySelector<HTMLElement>('[data-rmore-wrap]')!;
    const moreCount = root.querySelector<HTMLElement>('[data-rmore-count]')!;
    const applyLimit = () => {
      let shown = 0;
      let hiddenBlocks = 0;
      blocks.forEach((b) => {
        if (b.hidden) return;
        const n = b.querySelectorAll('li:not([hidden])').length;
        const collapse = !expanded && shown >= LIMIT;
        b.classList.toggle('is-more', collapse);
        if (collapse) hiddenBlocks++;
        else shown += n;
      });
      moreWrap.hidden = expanded || hiddenBlocks === 0;
      moreCount.textContent = hiddenBlocks ? `(${hiddenBlocks})` : '';
    };
    root.querySelector('[data-rmore]')!.addEventListener('click', () => {
      expanded = true;
      applyLimit();
    });

    // Filtry: zdjęcia w kategorii; blok bez pasujących zdjęć znika
    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const f = btn.dataset.filter!;
        root.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        blocks.forEach((block) => {
          let any = false;
          block.querySelectorAll<HTMLLIElement>('li[data-cat]').forEach((li) => {
            const show = f === 'all' || li.dataset.cat === f;
            li.hidden = !show;
            any ||= show;
          });
          block.hidden = !any;
        });
        visible = buttons.filter((b) => !b.closest('li')!.hidden).map((b) => Number(b.dataset.index));
        expanded = false;
        applyLimit();
      }),
    );
    applyLimit();

    // Podgląd: po kolei przez zdjęcia z bieżącego filtra, z nazwą realizacji w podpisie
    const show = (p: number) => {
      pos = (p + visible.length) % visible.length;
      const d = data[visible[pos]];
      img.src = d.src;
      img.alt = d.alt;
      cap.textContent = d.title ? `${d.title} — ${d.caption}` : d.caption;
      count.textContent = `${String(pos + 1).padStart(2, '0')} / ${String(visible.length).padStart(2, '0')}`;
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        opener = b;
        show(visible.indexOf(Number(b.dataset.index)));
        dialog.showModal();
      }),
    );
    root.querySelector('[data-rprev]')!.addEventListener('click', () => show(pos - 1));
    root.querySelector('[data-rnext]')!.addEventListener('click', () => show(pos + 1));
    root.querySelector('[data-rclose]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(pos - 1);
      if (e.key === 'ArrowRight') show(pos + 1);
    });
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(pos + (dx < 0 ? 1 : -1));
    });
  });
</script>
