---
import { Image } from 'astro:assets';
import type { Crumb } from '../layouts/Base.astro';
import type { Photo } from '../data/images';
import type { Drawing as DrawingName } from '../data/services';
import Breadcrumbs from './Breadcrumbs.astro';
import PhoneLink from './PhoneLink.astro';
import Drawing from './Drawing.astro';

interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  title: string;
  lead?: string;
  photo?: Photo;
  drawing?: DrawingName;
}
const { crumbs, eyebrow, title, lead, photo, drawing } = Astro.props;
const hasMedia = !!(photo || drawing);
---

<section data-hero class="relative isolate overflow-hidden bg-ink pb-16 pt-32 text-white md:pb-20 md:pt-40" aria-labelledby="page-title">
  <div class="grid-lines absolute inset-0 -z-10 opacity-60 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
  <div class:list={['container-x grid items-end gap-12', hasMedia && 'lg:grid-cols-[1.15fr_0.85fr]']}>
    <div data-hero-content>
      <div data-hero-fade><Breadcrumbs items={crumbs} /></div>
      <p class="eyebrow eyebrow-light mt-8" data-hero-fade>{eyebrow}</p>
      <h1 id="page-title" class="mt-4 text-[clamp(2.2rem,5vw,4.2rem)] font-extrabold leading-[1.02] tracking-[-0.03em] text-balance">
        <span data-hero-line><span>{title}</span></span>
      </h1>
      {lead && <p class="mt-6 max-w-2xl text-[1.05rem] leading-relaxed text-white/75" data-hero-fade>{lead}</p>}
      <div class="mt-8" data-hero-fade><PhoneLink location="page-hero" /></div>
      <slot />
    </div>
    {
      hasMedia && (
        <figure class="relative">
          <div class="aspect-[4/3] overflow-hidden rounded-lg border border-white/10" data-hero-media>
            {photo ? (
              <Image src={photo.src} alt={photo.alt} widths={[480, 760]} sizes="(min-width:1024px) 40vw, 100vw" loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
            ) : (
              <Drawing name={drawing!} label={`Rysunek techniczny: ${title}`} />
            )}
          </div>
          {!photo && (
            <figcaption class="mt-3 font-mono text-[0.6rem] uppercase tracking-[0.16em] text-white/60">Ilustracja poglądowa — rysunek techniczny</figcaption>
          )}
        </figure>
      )
    }
  </div>
</section>
