---
import type { Crumb } from '../layouts/Base.astro';

interface Props { items: Crumb[] }
const { items } = Astro.props;
---

<nav aria-label="Ścieżka nawigacji" class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-white/50">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true" class="text-sky">/</span>}
          {i === items.length - 1 ? (
            <span aria-current="page" class="text-white/80">{c.name}</span>
          ) : (
            <a href={c.href} class="transition-colors hover:text-white">{c.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
