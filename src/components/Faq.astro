---
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
  dark?: boolean;
}
const { items, dark = false } = Astro.props;
---

<div class="space-y-2.5">
  {
    items.map((item) => (
      <details
        class:list={[
          'group rounded-lg border transition-colors',
          dark ? 'border-white/10 bg-white/[0.03] open:bg-white/[0.06]' : 'border-ink/10 bg-white open:border-blue/30',
        ]}
        data-reveal
      >
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-5 py-4 text-[0.95rem] font-semibold [&::-webkit-details-marker]:hidden">
          {item.q}
          <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full text-blue transition-transform duration-300 group-open:rotate-45">
            <Icon name="plus" size={18} stroke={2} />
          </span>
        </summary>
        <p class:list={['px-5 pb-5 text-[0.95rem] leading-relaxed', dark ? 'text-white/70' : 'text-ink/70']}>{item.a}</p>
      </details>
    ))
  }
</div>
