---
// Ilustracje „blueprint” dla sześciu kart usług na stronie głównej.
// Jednolity system: granatowe tło, siatka techniczna, cienkie cyjanowe linie (1px niezależnie od skali).
interface Props {
  service: 'wykonanie' | 'naprawy' | 'przeglady' | 'ocieplanie' | 'okna' | 'odsniezanie';
  label: string;
  class?: string;
}
const { service, label, class: cls = '' } = Astro.props;
const uid = `bp-${service}`;

type P = [number, number];
const pt = (p: P) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
const line = (a: P, b: P) => `M${pt(a)}L${pt(b)}`;
const lerp = (a: P, b: P, t: number): P => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
const poly = (...ps: P[]) => `M${ps.map(pt).join('L')}Z`;

// 1. Wykonanie dachów — dach dwuspadowy w rzucie ukośnym z siatką dachówek
const g = { l: [40, 252] as P, apex: [112, 172] as P, r: [184, 252] as P };
const depth: P = [186, -94];
const add = (p: P, k = 1): P => [p[0] + depth[0] * k, p[1] + depth[1] * k];
const ridgeEnd = add(g.apex);
const eaveEnd = add(g.r);
const tiles: string[] = [];
for (let i = 1; i < 7; i++) {
  const t = i / 7;
  tiles.push(line(lerp(g.apex, g.r, t), lerp(ridgeEnd, eaveEnd, t)));
}
for (let i = 1; i < 11; i++) {
  const t = i / 11;
  tiles.push(line(lerp(g.apex, ridgeEnd, t), lerp(g.r, eaveEnd, t)));
}

// 5. Montaż okien — płaszczyzna dachu z oknem i kołnierzem
const O: P = [40, 246];
const U: P = [270, 0];
const V: P = [72, -180];
const at = (s: number, t: number): P => [O[0] + U[0] * s + V[0] * t, O[1] + U[1] * s + V[1] * t];
const quad = (s0: number, s1: number, t0: number, t1: number) => poly(at(s0, t0), at(s1, t0), at(s1, t1), at(s0, t1));
const winRows: string[] = [];
for (let i = 1; i < 9; i++) {
  const t = i / 9;
  if (t > 0.18 && t < 0.82) {
    winRows.push(line(at(0, t), at(0.33, t)), line(at(0.67, t), at(1, t)));
  } else winRows.push(line(at(0, t), at(1, t)));
}
for (let i = 1; i < 8; i++) {
  const s = i / 8;
  if (s > 0.3 && s < 0.7) winRows.push(line(at(s, 0), at(s, 0.18)), line(at(s, 0.82), at(s, 1)));
  else winRows.push(line(at(s, 0), at(s, 1)));
}

// 4. Ocieplanie — przekrój z warstwą izolacji między krokwiami
const ins = (a: P, b: P, n: number, amp: number) => {
  let d = `M${pt(a)}`;
  for (let i = 1; i <= n; i++) {
    const p = lerp(a, b, i / n);
    const m = lerp(a, b, (i - 0.5) / n);
    const nx = -(b[1] - a[1]);
    const ny = b[0] - a[0];
    const len = Math.hypot(nx, ny);
    const s = i % 2 ? amp : -amp;
    d += `Q${pt([m[0] + (nx / len) * s, m[1] + (ny / len) * s])} ${pt(p)}`;
  }
  return d;
};

// 6. Odśnieżanie — płatki śniegu
const flakes: [number, number, number][] = [[96, 58, 6], [158, 40, 5], [214, 66, 7], [276, 44, 5], [326, 70, 6], [130, 92, 4], [300, 104, 4]];
---

<svg viewBox="0 0 400 300" class:list={['block h-full w-full', cls]} role="img" aria-label={label} preserveAspectRatio="xMidYMid slice">
  <defs>
    <pattern id={`${uid}-minor`} width="10" height="10" patternUnits="userSpaceOnUse">
      <path d="M10 0H0V10" fill="none" stroke="#7cc4ff" stroke-opacity="0.045" />
    </pattern>
    <pattern id={`${uid}-major`} width="50" height="50" patternUnits="userSpaceOnUse">
      <path d="M50 0H0V50" fill="none" stroke="#7cc4ff" stroke-opacity="0.09" />
    </pattern>
    <radialGradient id={`${uid}-glow`} cx="55%" cy="50%" r="60%">
      <stop offset="0" stop-color="#1868f0" stop-opacity="0.22" />
      <stop offset="1" stop-color="#1868f0" stop-opacity="0" />
    </radialGradient>
    <linearGradient id={`${uid}-fill`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#38bdf8" stop-opacity="0.16" />
      <stop offset="1" stop-color="#38bdf8" stop-opacity="0.02" />
    </linearGradient>
  </defs>

  <rect width="400" height="300" fill="#0a1424" />
  <rect width="400" height="300" fill={`url(#${uid}-glow)`} />
  <rect width="400" height="300" fill={`url(#${uid}-minor)`} />
  <rect width="400" height="300" fill={`url(#${uid}-major)`} />

  <!-- znaczniki narożne -->
  <g stroke="#7cc4ff" stroke-opacity="0.35" fill="none" vector-effect="non-scaling-stroke">
    <path d="M14 22V14H22M378 14H386V22M386 278V286H378M22 286H14V278" vector-effect="non-scaling-stroke" />
  </g>

  <g fill="none" stroke="#5cc2ff" stroke-linecap="round" stroke-linejoin="round">
    {service === 'wykonanie' && (
      <>
        <path d={poly(g.apex, ridgeEnd, eaveEnd, g.r)} fill={`url(#${uid}-fill)`} stroke-opacity="0.9" vector-effect="non-scaling-stroke" />
        <path d={tiles.join('')} stroke-opacity="0.38" vector-effect="non-scaling-stroke" />
        <path d={line([g.apex[0], g.apex[1] - 5], [ridgeEnd[0], ridgeEnd[1] - 5])} stroke="#9bdcff" stroke-width="1.6" vector-effect="non-scaling-stroke" />
        <path d={poly(g.l, g.apex, g.r)} stroke-opacity="0.9" vector-effect="non-scaling-stroke" />
        <path d={`${line([g.l[0] - 8, g.l[1] + 6], [g.apex[0], g.apex[1] - 6])}${line([g.apex[0], g.apex[1] - 6], [g.r[0] + 8, g.r[1] + 6])}`} stroke-opacity="0.6" vector-effect="non-scaling-stroke" />
        <path d={`${line(g.l, [g.l[0], 292])}${line(g.r, [g.r[0], 292])}${line(eaveEnd, [eaveEnd[0], 196])}`} stroke-opacity="0.45" vector-effect="non-scaling-stroke" />
        <path d={line(add(g.l), ridgeEnd)} stroke-opacity="0.25" stroke-dasharray="3 4" vector-effect="non-scaling-stroke" />
        <path d={`${line([g.l[0], 270], [g.r[0], 270])}M${g.l[0]} 265v10M${g.r[0]} 265v10`} stroke="#38bdf8" stroke-opacity="0.7" vector-effect="non-scaling-stroke" />
      </>
    )}

    {service === 'naprawy' && (
      <>
        <path d="M40 70 262 214M40 84 262 228M40 98 250 234" stroke-opacity="0.85" vector-effect="non-scaling-stroke" />
        <path d={Array.from({ length: 11 }).map((_, i) => { const p = lerp([44, 60], [258, 199], i / 11); return `M${pt(p)}l14 -2l-4 12`; }).join('')} stroke-opacity="0.5" vector-effect="non-scaling-stroke" />
        <path d="M228 222V292M244 232V292" stroke-opacity="0.55" vector-effect="non-scaling-stroke" />
        <path d="M252 222h56v6a28 28 0 0 1-56 0z" fill={`url(#${uid}-fill)`} stroke="#9bdcff" stroke-width="1.4" vector-effect="non-scaling-stroke" />
        <path d="M270 254v22q0 10 -10 10h-8M286 254v22q0 26 -26 26h-8" stroke-opacity="0.85" vector-effect="non-scaling-stroke" />
        <path d="M322 184v80M316 184h12M316 264h12" stroke="#38bdf8" stroke-opacity="0.7" vector-effect="non-scaling-stroke" />
        <circle cx="214" cy="190" r="26" stroke="#38bdf8" stroke-dasharray="3 4" stroke-opacity="0.8" vector-effect="non-scaling-stroke" />
        <path d="M188 150c0 6-4 9-4 12a4 4 0 0 0 8 0c0-3-4-6-4-12zM166 160c0 5-3 7-3 9a3 3 0 0 0 6 0c0-2-3-4-3-9z" stroke="#9bdcff" stroke-opacity="0.8" vector-effect="non-scaling-stroke" />
        <path d="M244 162h40" stroke-opacity="0.35" vector-effect="non-scaling-stroke" />
      </>
    )}

    {service === 'przeglady' && (
      <>
        <path d="M58 238 190 92 322 238Z" fill={`url(#${uid}-fill)`} stroke-opacity="0.9" vector-effect="non-scaling-stroke" />
        <path d="M84 226 190 110 296 226Z" stroke-opacity="0.55" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
        <path d="M48 246 190 82 332 246" stroke="#9bdcff" stroke-width="1.4" vector-effect="non-scaling-stroke" />
        <path d={Array.from({ length: 6 }).map((_, i) => `${line(lerp([58, 238], [190, 92], (i + 1) / 7), lerp([84, 226], [190, 110], (i + 1) / 7))}${line(lerp([322, 238], [190, 92], (i + 1) / 7), lerp([296, 226], [190, 110], (i + 1) / 7))}`).join('')} stroke-opacity="0.4" vector-effect="non-scaling-stroke" />
        <path d="M58 262H322M58 256v12M322 256v12M66 262l-8-3v6zM314 262l8-3v6z" stroke="#38bdf8" stroke-opacity="0.75" vector-effect="non-scaling-stroke" />
        <circle cx="262" cy="132" r="34" fill="#0a1424" fill-opacity="0.6" stroke="#9bdcff" stroke-width="1.4" vector-effect="non-scaling-stroke" />
        <path d="M286 156 314 184" stroke="#9bdcff" stroke-width="3" vector-effect="non-scaling-stroke" />
        <path d="M262 108v48M238 132h48" stroke-opacity="0.4" vector-effect="non-scaling-stroke" />
        <path d="M244 146 272 116" stroke="#5cc2ff" vector-effect="non-scaling-stroke" />
        {[[124, 166], [190, 92], [256, 166]].map(([x, y]) => <circle cx={x} cy={y} r="4" stroke="#38bdf8" vector-effect="non-scaling-stroke" />)}
      </>
    )}

    {service === 'ocieplanie' && (
      <>
        <path d="M44 244 200 88 356 244" stroke="#9bdcff" stroke-width="1.4" vector-effect="non-scaling-stroke" />
        <path d="M74 244 200 118 326 244" stroke-opacity="0.7" vector-effect="non-scaling-stroke" />
        <path d="M74 244 200 118 326 244 304 244 200 140 96 244Z" fill={`url(#${uid}-fill)`} stroke="none" />
        <path d={`${ins([84, 238], [200, 124], 14, 7)}${ins([200, 124], [316, 238], 14, 7)}`} stroke="#38bdf8" stroke-opacity="0.85" vector-effect="non-scaling-stroke" />
        <path d="M96 244 200 140 304 244" stroke-opacity="0.5" stroke-dasharray="2 3" vector-effect="non-scaling-stroke" />
        <path d="M30 244H370M30 252H370" stroke-opacity="0.45" vector-effect="non-scaling-stroke" />
        <path d="M168 230c-6-8 6-14 0-22s6-14 0-22M200 230c-6-8 6-14 0-22s6-14 0-22M232 230c-6-8 6-14 0-22s6-14 0-22" stroke="#9bdcff" stroke-opacity="0.55" vector-effect="non-scaling-stroke" />
        <path d="M162 186l6-6 6 6M194 186l6-6 6 6M226 186l6-6 6 6" stroke="#9bdcff" stroke-opacity="0.55" vector-effect="non-scaling-stroke" />
        <path d="M290 168h46M274 186h62M258 204h78" stroke-opacity="0.35" vector-effect="non-scaling-stroke" />
        {[168, 186, 204].map((y) => <circle cx="336" cy={y} r="2" fill="#38bdf8" stroke="none" />)}
      </>
    )}

    {service === 'okna' && (
      <>
        <path d={poly(at(0, 0), at(1, 0), at(1, 1), at(0, 1))} stroke-opacity="0.8" vector-effect="non-scaling-stroke" />
        <path d={winRows.join('')} stroke-opacity="0.3" vector-effect="non-scaling-stroke" />
        <path d={quad(0.33, 0.67, 0.18, 0.82)} stroke-opacity="0.75" vector-effect="non-scaling-stroke" />
        <path d={quad(0.37, 0.63, 0.24, 0.76)} fill={`url(#${uid}-fill)`} stroke="#9bdcff" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        <path d={quad(0.4, 0.6, 0.28, 0.72)} stroke-opacity="0.9" vector-effect="non-scaling-stroke" />
        <path d={`${line(at(0.43, 0.38), at(0.5, 0.62))}${line(at(0.47, 0.34), at(0.56, 0.6))}`} stroke="#9bdcff" stroke-opacity="0.45" vector-effect="non-scaling-stroke" />
        <path d={`${line(at(0.33, 0.18), at(0.37, 0.24))}${line(at(0.67, 0.18), at(0.63, 0.24))}${line(at(0.67, 0.82), at(0.63, 0.76))}${line(at(0.33, 0.82), at(0.37, 0.76))}`} stroke-opacity="0.6" vector-effect="non-scaling-stroke" />
        <path d={`${line(at(0.78, 0.24), at(0.78, 0.76))}${line(at(0.75, 0.24), at(0.81, 0.24))}${line(at(0.75, 0.76), at(0.81, 0.76))}`} stroke="#38bdf8" stroke-opacity="0.75" vector-effect="non-scaling-stroke" />
      </>
    )}

    {service === 'odsniezanie' && (
      <>
        <path d="M46 246 200 116 354 246" stroke="#9bdcff" stroke-width="1.6" vector-effect="non-scaling-stroke" />
        <path d="M58 246 200 126 342 246" stroke-opacity="0.55" vector-effect="non-scaling-stroke" />
        <path d="M54 234q16-10 30-24t34-30q18-14 36-30t46-38q28 24 46 38t36 30q20 16 34 30t30 24" fill={`url(#${uid}-fill)`} stroke="#5cc2ff" stroke-opacity="0.8" vector-effect="non-scaling-stroke" />
        <path d="M102 212v-12M298 212v-12M96 206l12-2M292 204l12 2" stroke="#38bdf8" stroke-opacity="0.75" vector-effect="non-scaling-stroke" />
        <path d="M262 150l40 34M296 176l6 8-10-1" stroke="#38bdf8" stroke-opacity="0.65" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" />
        <path d="M46 262H354" stroke-opacity="0.3" stroke-dasharray="3 5" vector-effect="non-scaling-stroke" />
        {flakes.map(([x, y, r]) => (
          <path
            transform={`translate(${x} ${y})`}
            d={`M0 ${-r}V${r}M${-r * 0.87} ${-r / 2}L${r * 0.87} ${r / 2}M${r * 0.87} ${-r / 2}L${-r * 0.87} ${r / 2}`}
            stroke="#e6f6ff"
            stroke-opacity="0.75"
            vector-effect="non-scaling-stroke"
          />
        ))}
      </>
    )}
  </g>
</svg>
