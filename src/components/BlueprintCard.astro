---
// Ilustracje „blueprint” dla sześciu kart usług na stronie głównej.
// Jednolity system: granatowe tło, siatka techniczna, cienkie cyjanowe linie (1px niezależnie od skali).
interface Props {
  service: 'wykonanie' | 'naprawy' | 'przeglady' | 'ocieplanie' | 'okna' | 'odsniezanie' | 'serwis' | 'wycena' | 'przedzimowy' | 'obrobki';
  label: string;
  class?: string;
}
const { service, label, class: cls = '' } = Astro.props;
const uid = `bp-${service}`;

type P = [number, number];
const pt = (p: P) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`;
const line = (a: P, b: P) => `M${pt(a)}L${pt(b)}`;
const lerp = (a: P, b: P, t: number): P => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
const poly = (...ps: P[]) => `M${ps.map(pt).join('L')}Z`;

// 1. Wykonanie dachów — dach dwuspadowy w rzucie ukośnym z siatką dachówek
const g = { l: [40, 252] as P, apex: [112, 172] as P, r: [184, 252] as P };
const depth: P = [186, -94];
const add = (p: P, k = 1): P => [p[0] + depth[0] * k, p[1] + depth[1] * k];
const ridgeEnd = add(g.apex);
const eaveEnd = add(g.r);
const tiles: string[] = [];
for (let i = 1; i < 7; i++) {
  const t = i / 7;
  tiles.push(line(lerp(g.apex, g.r, t), lerp(ridgeEnd, eaveEnd, t)));
}
for (let i = 1; i < 11; i++) {
  const t = i / 11;
  tiles.push(line(lerp(g.apex, ridgeEnd, t), lerp(g.r, eaveEnd, t)));
}

// 5. Montaż okien — płaszczyzna dachu z oknem i kołnierzem
const O: P = [40, 246];
const U: P = [270, 0];
const V: P = [72, -180];
const at = (s: number, t: number): P => [O[0] + U[0] * s + V[0] * t, O[1] + U[1] * s + V[1] * t];
const quad = (s0: number, s1: number, t0: number, t1: number) => poly(at(s0, t0), at(s1, t0), at(s1, t1), at(s0, t1));
const winRows: string[] = [];
for (let i = 1; i < 9; i++) {
  const t = i / 9;
  if (t > 0.18 && t < 0.82) {
    winRows.push(line(at(0, t), at(0.33, t)), line(at(0.67, t), at(1, t)));
  } else winRows.push(line(at(0, t), at(1, t)));
}
for (let i = 1; i < 8; i++) {
  const s = i / 8;
  if (s > 0.3 && s < 0.7) winRows.push(line(at(s, 0), at(s, 0.18)), line(at(s, 0.82), at(s, 1)));
  else winRows.push(line(at(s, 0), at(s, 1)));
}

// 4. Ocieplanie — przekrój z warstwą izolacji między krokwiami
const ins = (a: P, b: P, n: number, amp: number) => {
  let d = `M${pt(a)}`;
  for (let i = 1; i <= n; i++) {
    const p = lerp(a, b, i / n);
    const m = lerp(a, b, (i - 0.5) / n);
    const nx = -(b[1] - a[1]);
    const ny = b[0] - a[0];
    const len = Math.hypot(nx, ny);
    const s = i % 2 ? amp : -amp;
    d += `Q${pt([m[0] + (nx / len) * s, m[1] + (ny / len) * s])} ${pt(p)}`;
  }
  return d;
};

// 6. Odśnieżanie — płatki śniegu
const flakes: [number, number, number][] = [[96, 58, 6], [158, 40, 5], [214, 66, 7], [276, 44, 5], [326, 70, 6], [130, 92, 4], [300, 104, 4]];

// Serwis / przegląd przedzimowy — dom w elewacji z dachówkami (wspólna baza dla obu rysunków)
const house = (x: number, base: number, w: number, wallH: number, roofH: number) => {
  const top = base - wallH;
  const apex: P = [x + w / 2, top - roofH];
  const eaveL: P = [x - 18, top + 6];
  const eaveR: P = [x + w + 18, top + 6];
  const rows: string[] = [];
  for (let i = 1; i < 6; i++) {
    const t = i / 6;
    rows.push(line(lerp(apex, eaveL, t), lerp(apex, eaveR, t)));
  }
  for (let i = 1; i < 10; i++) {
    const t = i / 10;
    rows.push(line(apex, lerp(eaveL, eaveR, t)));
  }
  return {
    walls: `M${x} ${top + 6}V${base}H${x + w}V${top + 6}`,
    roof: poly(eaveL, apex, eaveR),
    tiles: rows.join(''),
    chimney: `M${x + w * 0.68} ${top - roofH * 0.55}V${top - roofH * 0.95}h18V${top - roofH * 0.36}`,
    door: `M${x + w * 0.18} ${base}V${base - 46}h26V${base}`,
    window: `M${x + w * 0.56} ${base - 62}h40v34h-40ZM${x + w * 0.56 + 20} ${base - 62}v34`,
  };
};
const hs = house(66, 252, 170, 78, 82);
const hp = house(110, 252, 170, 78, 82);

// Obróbki — połać ze stopniową obróbką komina
const slopeA: P = [24, 262];
const slopeB: P = [376, 120];
const slopeYAt = (x: number) => slopeA[1] + ((slopeB[1] - slopeA[1]) * (x - slopeA[0])) / (slopeB[0] - slopeA[0]);
const chX0 = 176, chX1 = 236;
const slopeTiles: string[] = [];
for (let i = 1; i < 7; i++) {
  const off = i * 17;
  slopeTiles.push(line([slopeA[0], slopeA[1] + off], [slopeB[0], slopeB[1] + off]));
}
for (let x = 44; x < 376; x += 26) {
  if (x > chX0 - 14 && x < chX1 + 14) continue;
  slopeTiles.push(line([x, slopeYAt(x)], [x, slopeYAt(x) + 104]));
}
