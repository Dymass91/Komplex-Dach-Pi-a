---
import { business, nav } from '../data/site';
import { services } from '../data/services';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-white/70">
  <div class="container-x grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.3fr_0.8fr_1fr_1fr_1fr] lg:gap-10">
    <div>
      <Logo width={170} />
      <p class="mt-6 max-w-xs text-sm leading-relaxed">
        Profesjonalne usługi dekarskie w Pile i w promieniu około 100 km. Kompleksowe dachy, naprawy, przeglądy, serwis
        i prace przy dachu.
      </p>
    </div>

    <nav aria-label="Nawigacja w stopce">
      <h2 class="mb-5 text-sm font-semibold text-white">Nawigacja</h2>
      <ul class="space-y-2.5 text-sm">
        {nav.map((n) => <li><a class="transition-colors hover:text-white" href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Usługi">
      <h2 class="mb-5 text-sm font-semibold text-white">Usługi</h2>
      <ul class="space-y-2.5 text-sm">
        {
          services.map((s) => (
            <li><a class="transition-colors hover:text-white" href={`/uslugi/${s.slug}/`}>{s.name}</a></li>
          ))
        }
        <li><a class="transition-colors hover:text-white" href="/mycie-dachow/">Mycie dachów</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="mb-5 text-sm font-semibold text-white">Obszar działania</h2>
      <p class="text-sm leading-relaxed">Piła i miejscowości w promieniu około {business.radiusKm} km — sprawdź, czy dojeżdżamy do Ciebie.</p>
      <a
        href="/obszar-dzialania/"
        class="group mt-5 inline-flex items-center gap-2 whitespace-nowrap rounded-md border border-sky/40 px-3.5 py-2.5 text-[0.82rem] font-semibold text-white transition-colors hover:border-sky hover:bg-sky/10"
      >
        Zobacz obszar działania
        <Icon name="arrow" size={16} class="text-sky transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>

    <div>
      <h2 class="mb-5 text-sm font-semibold text-white">Szybki kontakt</h2>
      <a href={business.phoneHref} data-call="footer" class="group flex items-start gap-3">
        <Icon name="call" size={26} class="mt-0.5 text-blue" />
        <span>
          <span class="block text-xl font-bold text-white transition-colors group-hover:text-sky">{business.phoneDisplay}</span>
          <span class="text-sm">Zadzwoń i umów wycenę</span>
        </span>
      </a>
      <div class="mt-6 flex items-start gap-3">
        <Icon name="pin" size={26} class="mt-0.5 text-blue" />
        <p class="text-sm">
          <span class="block text-base font-semibold text-white">Piła</span>
          Obsługujemy klientów w promieniu około {business.radiusKm} km
        </p>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {business.name}. Wszelkie prawa zastrzeżone.</p>
      <p>
        Kontakt wyłącznie telefoniczny: <a class="text-white/80 underline decoration-white/40 underline-offset-2 hover:text-white" href={business.phoneHref}>{business.phoneDisplay}</a>
        <span class="mx-2 text-white/30">·</span>
        <a class="text-white/80 underline decoration-white/40 underline-offset-2 hover:text-white" href="/polityka-prywatnosci/">Polityka prywatności</a>
      </p>
    </div>
  </div>
</footer>
