---
// Galeria autentycznych realizacji: mozaika + podgląd pełnoekranowy (<dialog>).
import { Image, getImage } from 'astro:assets';
import { photos, portfolio } from '../data/images';
import Icon from './Icon.astro';

interface Props {
  layout?: 'mosaic' | 'grid';
  limit?: number;
}
const { layout = 'mosaic', limit } = Astro.props;
const items = (limit ? portfolio.slice(0, limit) : portfolio).map((p) => ({ ...p, photo: photos[p.key] }));
const full = await Promise.all(items.map((i) => getImage({ src: i.photo.src, format: 'webp', quality: 85 })));

// Układ mozaiki (desktop, siatka 12 kolumn × 2 rzędy) — jak w referencji
const mosaic = [
  'md:col-span-2 md:row-span-2',
  'md:col-span-3 md:row-span-2',
  'md:col-span-2',
  'md:col-span-2 md:col-start-6 md:row-start-2',
  'md:col-span-3 md:row-span-2 md:col-start-8 md:row-start-1',
  'md:col-span-2 md:col-start-11 md:row-start-1',
  'md:col-span-2 md:col-start-11 md:row-start-2',
];
---

<div data-gallery>
  <ul
    class:list={[
      'grid gap-2.5',
      layout === 'mosaic'
        ? 'grid-flow-dense grid-cols-2 auto-rows-[160px] sm:auto-rows-[200px] md:grid-cols-12 md:grid-rows-[170px_170px] lg:grid-rows-[200px_200px]'
        : 'grid-cols-2 auto-rows-[180px] sm:auto-rows-[240px] md:grid-cols-3 md:auto-rows-[300px]',
    ]}
  >
    {
      items.map((item, i) => (
        <li class:list={[layout === 'mosaic' && mosaic[i], layout === 'mosaic' && i === 1 && 'col-span-2 max-md:row-span-2', 'relative']}>
          <button
            type="button"
            class="group relative block h-full w-full overflow-hidden rounded-md bg-graphite text-left"
            data-index={i}
            aria-label={`Powiększ zdjęcie: ${item.caption}`}
          >
            <span class="block h-full w-full" data-reveal-img>
              <Image
                src={item.photo.src}
                alt={item.photo.alt}
                widths={[380, 680]}
                sizes="(min-width: 768px) 30vw, 50vw"
                class="h-full w-full object-cover transition-transform duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-[1.06]"
              />
            </span>
            <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/0 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-focus-visible:opacity-100" />
            <span class="pointer-events-none absolute inset-x-3 bottom-3 translate-y-2 text-[0.8rem] font-semibold leading-snug text-white opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">
              <span class="mb-1 block font-mono text-[0.6rem] font-medium uppercase tracking-[0.16em] text-sky">{String(i + 1).padStart(2, '0')}</span>
              {item.caption}
            </span>
          </button>
          {layout === 'mosaic' && i === items.length - 1 && (
            <a
              href="/realizacje/"
              class="absolute right-3 top-1/2 hidden h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-ink/80 text-white backdrop-blur transition-colors hover:bg-blue md:grid md:top-0 md:-translate-y-[calc(50%+5px)]"
              aria-label="Zobacz wszystkie realizacje"
            >
              <Icon name="arrow" size={20} />
            </a>
          )}
        </li>
      ))
    }
  </ul>

  <dialog
    class="m-0 h-full max-h-none w-full max-w-none bg-ink/95 p-0 text-white backdrop:bg-ink/80 open:flex open:flex-col"
    aria-label="Podgląd zdjęcia"
    data-lightbox
  >
    <div class="flex items-center justify-between px-5 py-4">
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-white/60"><span data-lb-count></span></p>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-full hover:bg-white/10" data-lb-close aria-label="Zamknij podgląd">
        <Icon name="close" size={24} />
      </button>
    </div>
    <figure class="flex min-h-0 flex-1 flex-col items-center justify-center gap-4 px-4 pb-6">
      <img data-lb-img src={full[0]?.src} width={full[0]?.attributes.width} height={full[0]?.attributes.height} alt="" loading="lazy" decoding="async" class="h-auto max-h-[78vh] w-auto max-w-full rounded object-contain" />
      <figcaption data-lb-caption class="text-center text-sm text-white/75"></figcaption>
    </figure>
    <div class="absolute inset-y-0 left-0 flex items-center px-2 sm:px-5">
      <button type="button" class="grid h-12 w-12 place-items-center rounded-full bg-white/10 hover:bg-blue" data-lb-prev aria-label="Poprzednie zdjęcie">
        <Icon name="arrow-left" size={22} />
      </button>
    </div>
    <div class="absolute inset-y-0 right-0 flex items-center px-2 sm:px-5">
      <button type="button" class="grid h-12 w-12 place-items-center rounded-full bg-white/10 hover:bg-blue" data-lb-next aria-label="Następne zdjęcie">
        <Icon name="arrow" size={22} />
      </button>
    </div>
  </dialog>

  <script
    type="application/json"
    data-lb-data
    set:html={JSON.stringify(items.map((it, i) => ({ src: full[i].src, alt: it.photo.alt, caption: it.caption })))}
  />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = root.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = root.querySelector<HTMLElement>('[data-lb-caption]')!;
    const count = root.querySelector<HTMLElement>('[data-lb-count]')!;
    const data: { src: string; alt: string; caption: string }[] = JSON.parse(root.querySelector('[data-lb-data]')!.textContent || '[]');
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + data.length) % data.length;
      const d = data[index];
      img.animate?.([{ opacity: 0, transform: 'scale(0.98)' }, { opacity: 1, transform: 'none' }], { duration: 380, easing: 'cubic-bezier(.16,1,.3,1)' });
      img.src = d.src;
      img.alt = d.alt;
      caption.textContent = d.caption;
      count.textContent = `${String(index + 1).padStart(2, '0')} / ${String(data.length).padStart(2, '0')}`;
    };

    root.querySelectorAll<HTMLButtonElement>('button[data-index]').forEach((btn) =>
      btn.addEventListener('click', () => {
        opener = btn;
        show(Number(btn.dataset.index));
        dialog.showModal();
      }),
    );
    root.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    root.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    // Gesty przesunięcia na telefonach
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  });
</script>
